[Unit]
Description=Sauvegarde MyWorkshop (base PostgreSQL + fichiers)
After=postgresql.service

[Service]
Type=oneshot
User=myworkshop
Group=myworkshop
# Lancé via bash : le bit exécutable n'est pas garanti après un clone Git depuis Windows.
ExecStart=/bin/bash /opt/myworkshop/app/deploy/backup/backup.sh

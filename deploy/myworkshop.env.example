# Copier vers /etc/myworkshop/myworkshop.env (chmod 640, root:myworkshop)
# Connexion par socket Unix avec authentification « peer » : pas de mot de passe stocké.
MW_DATABASE_URL=postgresql+psycopg://myworkshop@/myworkshop?host=/var/run/postgresql
MW_DATA_DIR=/var/lib/myworkshop/data
MW_COOKIE_SECURE=true
MW_SESSION_TTL_DAYS=30
# Vide : les QR contiennent seulement le code (QR-000001), lisible par le scanner de l'application.
# Renseigné (ex. https://daniel.ldns.fr) : les QR contiennent https://daniel.ldns.fr/l/QR-000001
# et s'ouvrent avec l'appareil photo du téléphone. Définitif une fois imprimé.
MW_QR_PUBLIC_URL=

# --- IA (facultatif) ---
# Recherche par photo : modèle CLIP local (pip install ".[ai]"). false pour désactiver.
MW_AI_EMBEDDINGS=true
# Identification par un service externe compatible OpenAI. Laisser vide pour rester 100 % local.
# Même renseigné, l'envoi de photos reste désactivé tant qu'un administrateur ne l'active pas
# (Accueil → Réglages). Exemple avec l'offre gratuite de Google Gemini (clé sur
# https://aistudio.google.com/apikey) :
#   MW_AI_REMOTE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   MW_AI_REMOTE_MODEL=gemini-flash-lite-latest
#   MW_AI_REMOTE_KEY=la-cle
# Ollama sur un PC du réseau : MW_AI_REMOTE_URL=http://IP-DU-PC:11434/v1, MW_AI_REMOTE_MODEL=llava, clé vide.
MW_AI_REMOTE_URL=
MW_AI_REMOTE_MODEL=
MW_AI_REMOTE_KEY=

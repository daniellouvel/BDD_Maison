[Unit]
Description=MyWorkshop API (FastAPI)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=myworkshop
Group=myworkshop
WorkingDirectory=/opt/myworkshop/app/backend
EnvironmentFile=/etc/myworkshop/myworkshop.env
# Cache du téléchargement des modèles IA : seul /var/lib/myworkshop est inscriptible (ProtectSystem).
Environment=HF_HOME=/var/lib/myworkshop/data/models/hf
# Un seul processus : chaque processus chargerait son propre modèle CLIP (~500 Mo de RAM).
ExecStart=/opt/myworkshop/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --workers 1
Restart=on-failure
RestartSec=5

# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myworkshop

[Install]
WantedBy=multi-user.target
